# Google AI Studio API Key - get yours at https://aistudio.google.com
GOOGLE_API_KEY=your_google_api_key_here

# LLM Models
LLM_MODEL=gemini-3.5-flash-lite
JUDGE_MODEL=gemini-3.5-flash-lite
EVAL_MODEL=gemini-3.5-flash-lite

# Embedding Models
ACTIVE_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_MODEL_A=gemini-embedding-001
EMBEDDING_MODEL_B=gemini-embedding-2

# App Settings
APP_NAME=Production RAG Service
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# CORS - list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ChromaDB
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION_NAME=rag_documents

# Retrieval
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.35

# Chunking (Config A - production default)
ACTIVE_CHUNK_SIZE=512
ACTIVE_CHUNK_OVERLAP=50

# File Upload
MAX_FILE_SIZE_MB=50

# LLM
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=30
